{
  "name": "@philflow/tsdav",
  "version": "2.5.0",
  "description": "WebDAV, CalDAV and CardDAV client for Node.js and the browser (PhilflowIO fork of tsdav with VTODO, MKCOL address books and Digest auth)",
  "keywords": [
    "dav",
    "caldav",
    "carddav",
    "webdav",
    "ical",
    "vcard",
    "addressbook",
    "calendar",
    "calendars",
    "contacts",
    "contact",
    "sync",
    "nodejs",
    "browser",
    "bun",
    "deno",
    "typescript"
  ],
  "homepage": "https://tsdav.vercel.app/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PhilflowIO/tsdav.git"
  },
  "bugs": {
    "url": "https://github.com/PhilflowIO/tsdav/issues"
  },
  "license": "MIT",
  "author": "linlilulll@gmail.com",
  "exports": {
    ".": {
      "types": "./dist/tsdav.d.ts",
      "browser": "./dist/tsdav.js",
      "deno": "./dist/tsdav.mjs",
      "bun": "./dist/tsdav.mjs",
      "worker": "./dist/tsdav.js",
      "import": "./dist/tsdav.mjs",
      "require": "./dist/tsdav.cjs.js",
      "default": "./dist/tsdav.mjs"
    },
    "./package.json": "./package.json"
  },
  "main": "dist/tsdav.cjs.js",
  "module": "dist/tsdav.mjs",
  "types": "dist/tsdav.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node scripts/clean-dist.cjs && tsc -p tsconfig.build.json --emitDeclarationOnly --declarationDir dist && rolldown -c rolldown.config.mjs && node scripts/finalize-dist.cjs",
    "clean": "node scripts/clean-dist.cjs",
    "lint": "biome check src",
    "prepublishOnly": "pnpm build",
    "test": "vitest run src/__tests__/unit src/util/__tests__",
    "test:apple": "vitest run src/__tests__/integration/apple --no-file-parallelism",
    "test:baikal": "vitest run src/__tests__/integration/baikal --no-file-parallelism",
    "test:coverage": "vitest run src/__tests__/unit src/util/__tests__ --coverage",
    "test:coverage:report": "vitest run src/__tests__/unit src/util/__tests__ --coverage --coverage.reporter=lcov --coverage.reporter=text-summary",
    "test:fastmail": "vitest run src/__tests__/integration/fastmail --no-file-parallelism",
    "test:google": "vitest run src/__tests__/integration/google --no-file-parallelism",
    "test:nextcloud": "vitest run src/__tests__/integration/nextcloud --no-file-parallelism",
    "test:unit": "vitest run src/__tests__/unit src/util/__tests__",
    "test:zoho": "vitest run src/__tests__/integration/zoho --no-file-parallelism",
    "typecheck": "tsc --noEmit",
    "watch": "tsc --watch --outDir ./dist",
    "check:dependencies": "knip --dependencies",
    "test:consumer": "tsc -p tests/consumer/tsconfig.json --noEmit",
    "test:examples": "node scripts/check-doc-examples.cjs && vitest run tests/docs-examples.test.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "debug": "4.4.3",
    "xml-js": "1.6.11"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@types/debug": "4.1.13",
    "@types/node": "26.4.1",
    "@vitest/coverage-v8": "^5.0.0",
    "dotenv": "17.4.2",
    "husky": "^9.1.7",
    "ical.js": "^2.2.1",
    "knip": "^6.39.0",
    "rolldown": "1.2.7",
    "typescript": "7.0.2",
    "vitest": "^5.0.0"
  },
  "packageManager": "pnpm@10.34.4",
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
